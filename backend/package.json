{
  "name": "synapse-backend",
  "version": "1.0.0",
  "description": "Synapse backend API",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --exec \"npx ts-node --transpile-only\" src/index.ts",
    "migrate": "npx ts-node --transpile-only src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "deploy": "npm run build && npm run start"
  },
  "dependencies": {
    "@google/generative-ai": "^0.2.1",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^8.1.0",
    "jest": "^30.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.4",
    "pg": "^8.16.3",
    "pg-connection-string": "^2.6.4",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "speakeasy": "^2.0.0",
    "stripe": "^22.1.1",
    "ts-jest": "^29.4.6",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7",
    "y-leveldb": "^0.2.0",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.23",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.23",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/socket.io": "^3.0.1",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.8",
    "@types/web-push": "^3.6.4",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}
