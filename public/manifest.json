{
  "short_name": "Synapse",
  "name": "Synapse — where ideas meet builders",
  "description": "A collaborative platform where thinkers, doers, and investors turn ideas into shipped projects. Real-time discussion forums, AI idea coach, mentorship, and built-in project tools.",
  "lang": "en",
  "dir": "ltr",
  "scope": "/Synapse/",
  "start_url": "/Synapse/",
  "id": "/Synapse/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#6366F1",
  "background_color": "#0A0A0F",
  "categories": ["business", "productivity", "social", "education"],
  "iarc_rating_id": "",
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "icons": [
    { "src": "/Synapse/icons/icon-192.png", "type": "image/png", "sizes": "192x192", "purpose": "any" },
    { "src": "/Synapse/icons/icon-192.png", "type": "image/png", "sizes": "192x192", "purpose": "maskable" },
    { "src": "/Synapse/icons/icon-512.png", "type": "image/png", "sizes": "512x512", "purpose": "any" },
    { "src": "/Synapse/icons/icon-512.png", "type": "image/png", "sizes": "512x512", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "/Synapse/screenshots/screenshot-desktop-1.png", "type": "image/png", "sizes": "1280x720", "form_factor": "wide", "label": "Discover ideas with personalized feed" },
    { "src": "/Synapse/screenshots/screenshot-mobile-1.png", "type": "image/png", "sizes": "720x1280", "form_factor": "narrow", "label": "Collaborate from anywhere" }
  ],
  "shortcuts": [
    {
      "name": "New idea",
      "short_name": "New",
      "description": "Start sharing a new idea",
      "url": "/Synapse/?action=new-idea",
      "icons": [{ "src": "/Synapse/icons/shortcut-new-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Messages",
      "short_name": "Inbox",
      "description": "Your conversations",
      "url": "/Synapse/?action=inbox",
      "icons": [{ "src": "/Synapse/icons/shortcut-inbox-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Explore ideas",
      "short_name": "Explore",
      "description": "Discover new ideas",
      "url": "/Synapse/?action=explore",
      "icons": [{ "src": "/Synapse/icons/shortcut-explore-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Quests & streaks",
      "short_name": "Quests",
      "description": "Your weekly challenges",
      "url": "/Synapse/?action=quests",
      "icons": [{ "src": "/Synapse/icons/shortcut-new-96.png", "sizes": "96x96" }]
    }
  ],
  "share_target": {
    "action": "/Synapse/?action=new-idea",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "summary",
      "url": "url"
    }
  },
  "protocol_handlers": [
    { "protocol": "web+synapse", "url": "/Synapse/?route=%s" }
  ]
}
