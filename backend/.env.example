# ============================================================================
# Synapse Backend — Environment Variables
# Copy to .env and fill in. NEVER commit .env to git.
# ============================================================================

NODE_ENV=development
PORT=3001
APP_URL=https://synapse.app
CORS_ORIGIN=http://localhost:5173,https://synapse.app

# ─── DATABASE ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── AUTH ────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_SECRET=replace-with-64-char-random-string
JWT_EXPIRES_IN=30d

# ─── EMAIL (transactional + digests) ─────────────────────────────────────────
SENDGRID_API_KEY=SG.xxx
EMAIL_FROM="Synapse <hello@synapse.app>"
# Alternative: MAILGUN_API_KEY / POSTMARK_API_KEY / RESEND_API_KEY

# ─── AI (Google Gemini) ──────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy...
# Optional alternatives: OPENAI_API_KEY / ANTHROPIC_API_KEY

# ─── STRIPE BILLING ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx
STRIPE_PRICE_INVESTOR_MONTHLY=price_xxx
STRIPE_PRICE_INVESTOR_YEARLY=price_xxx
STRIPE_CONNECT_RETURN_URL=https://synapse.app/settings/payouts

# ─── PUSH NOTIFICATIONS (Web Push) ───────────────────────────────────────────
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BN...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:push@synapse.app

# ─── FILE UPLOADS ────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=5242880

# ─── OAUTH PROVIDERS (optional sign-in / import) ─────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ─── SEARCH (Algolia — optional) ─────────────────────────────────────────────
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_SEARCH_INDEX=synapse_ideas

# ─── ERROR TRACKING + ANALYTICS ──────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ENVIRONMENT=production
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://us.i.posthog.com

# ─── CONTENT MODERATION (optional) ───────────────────────────────────────────
PERSPECTIVE_API_KEY=

# ─── REDIS (optional — rate limiting, presence, queues) ──────────────────────
REDIS_URL=redis://localhost:6379

# ─── SMS (optional — Twilio for 2FA backup / alerts) ─────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── RATE LIMITING ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_MIN=120
LOGIN_RATE_LIMIT=5

# ─── ADMIN / OPS ─────────────────────────────────────────────────────────────
ADMIN_EMAILS=you@synapse.app
INTERNAL_API_KEY=replace-with-shared-secret-for-cron-jobs

# ─── FEATURE FLAGS ───────────────────────────────────────────────────────────
ENABLE_BOUNTIES=true
ENABLE_MENTORSHIP=true
ENABLE_PUSH=true
ENABLE_WEEKLY_DIGEST=true
ENABLE_AI_COACH=true
